<?xml version="1.0" encoding="utf-8"?>
<!--
  碰锁开门的浮层: 贴在屏幕底部的一张卡片。
  外层 FrameLayout 全屏透明，只为把卡片定位到底部（触摸穿透由 Window flag 负责）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/unlock_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="34dp"
        android:background="@drawable/bg_unlock_card"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <com.unlock.door.ui.StatusGlyphView
            android:id="@+id/status_glyph"
            android:layout_width="46dp"
            android:layout_height="46dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#1A1814"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/card_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#8B8578"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
