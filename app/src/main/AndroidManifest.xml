<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- BLE 权限 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- NFC (磁标签开门 + 读卡器模式碰锁开门) -->
    <uses-permission android:name="android.permission.NFC" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <!-- NFC 为可选功能，无 NFC 的手机也能正常使用 BLE 开门 -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="共享开门"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimpleUnlock">

        <!-- 主界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          NFC 触发的开门入口（无界面，确认命中才弹底部浮层）：
            · unlockdoor:// 磁标签  → 直接开门
          放在这里而不是 MainActivity 上，是为了不让主界面挂一个可被任意 App / 网页
          用自定义 scheme 唤起的 intent-filter。

          这里**故意不注册 TECH_DISCOVERED**（技术类型兜底分发）：
            实测确认 TECH 分发在门锁标签上不成立 —— 系统按技术类型匹配时，
            NfcA 是所有 Type A 卡（校园卡 / 公交卡 / 银行卡）的公共基础技术，
            既筛不出门锁，也唤不起可靠的分发；真正能命中门锁标签的只有
            **NDEF + AAR 指名包名**这一条路（见「鸠占鹊巢」变体）。
            公开版不占官方包名，AAR 指不到它，所以「碰锁免打开 App 开门」
            这个能力在公开版上不存在，只保留磁标签入口。
        -->
        <activity
            android:name=".NfcTagDispatchActivity"
            android:exported="true"
            android:theme="@style/Theme.SimpleUnlock.Overlay"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:stateNotNeeded="true">

            <!-- 我们自己写入的磁标签 -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="unlockdoor" />
            </intent-filter>
        </activity>

        <!-- 桌面小组件 -->
        <receiver
            android:name=".DoorLockWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/door_lock_widget_info" />
        </receiver>

        <!-- 前台开门服务 -->
        <service
            android:name=".UnlockService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

    </application>
</manifest>
